# ── Server ───────────────────────────────────────────────
PORT=3000
# Set to true when serving over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
SESSION_DAYS=7

# ── Database (docker compose overrides this for the app container) ──
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://127.0.0.1:6379

# ── First super administrator (created on first start) ──
SEED_ADMIN_EMAIL=admin@wame.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── WhatsApp ─────────────────────────────────────────────
# simulated = built-in driver for dev/demo. A Baileys driver plugs in via WhatsAppDriver.
WA_DRIVER=simulated
DEFAULT_COUNTRY_CODE=62
APP_TIMEZONE=Asia/Jakarta

# ── Password reset ───────────────────────────────────────
# true returns the reset link in the API response (no mail transport yet). Use false in production.
EXPOSE_RESET_LINK=false

# ── AI agents (optional; without a key the offline rules engine is used) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
